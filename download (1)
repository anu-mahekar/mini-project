.audio-recorder {
  position: relative;
}

.recorder-controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
}

.record-button {
  padding: 16px 48px;
  font-size: 17px;
  font-weight: 500;
  border: none;
  border-radius: 22px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: inherit;
}

.record-button.start {
  background: #0071e3;
  color: white;
}

.record-button.start:hover:not(:disabled) {
  background: #0077ed;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 113, 227, 0.3);
}

.record-button.stop {
  background: #ff3b30;
  color: white;
}

.record-button.stop:hover {
  background: #ff453a;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(255, 59, 48, 0.3);
}

.record-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.mic-icon,
.stop-icon {
  font-size: 20px;
}

.recording-active {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  width: 100%;
}

.recording-indicator {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 24px;
  background: rgba(255, 59, 48, 0.1);
  border-radius: 20px;
  color: #ff3b30;
  font-weight: 500;
  font-size: 15px;
}

.pulse {
  width: 10px;
  height: 10px;
  background: #ff3b30;
  border-radius: 50%;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.2);
  }
}

.recording-preview {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.audio-player {
  width: 100%;
  background: #f5f5f7;
  padding: 20px;
  border-radius: 12px;
}

.audio-player audio {
  width: 100%;
}

.preview-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.submit-button,
.reset-button {
  padding: 12px 32px;
  font-size: 17px;
  font-weight: 400;
  border: none;
  border-radius: 22px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
}

.submit-button {
  background: #0071e3;
  color: white;
}

.submit-button:hover:not(:disabled) {
  background: #0077ed;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 113, 227, 0.3);
}

.reset-button {
  background: transparent;
  color: #86868b;
  border: 1px solid #d2d2d7;
}

.reset-button:hover:not(:disabled) {
  background: #f5f5f7;
  border-color: #86868b;
}

.submit-button:disabled,
.reset-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  border-radius: 12px;
  z-index: 10;
}

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #d2d2d7;
  border-top: 3px solid #0071e3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-overlay p {
  color: #86868b;
  font-weight: 400;
  font-size: 17px;
}
