.file-upload {
  position: relative;
}

.upload-area {
  border: 2px dashed #d2d2d7;
  border-radius: 18px;
  padding: 80px 40px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
  background: #f5f5f7;
}

.upload-area:hover {
  border-color: #0071e3;
  background: rgba(0, 113, 227, 0.05);
}

.upload-area.drag-active {
  border-color: #0071e3;
  background: rgba(0, 113, 227, 0.1);
  transform: scale(1.01);
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.upload-icon {
  font-size: 48px;
  margin-bottom: 8px;
  opacity: 0.6;
}

.upload-content h3 {
  color: #1d1d1f;
  font-size: 24px;
  font-weight: 600;
  margin: 0;
  letter-spacing: -0.5px;
}

.upload-content p {
  color: #86868b;
  font-size: 17px;
  margin: 0;
  font-weight: 400;
}

.file-preview {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px;
  background: #f5f5f7;
  border-radius: 12px;
}

.file-icon {
  font-size: 32px;
  opacity: 0.6;
}

.file-details h3 {
  color: #1d1d1f;
  font-size: 19px;
  font-weight: 500;
  margin: 0 0 4px 0;
  word-break: break-all;
  letter-spacing: -0.3px;
}

.file-details p {
  color: #86868b;
  font-size: 15px;
  margin: 0;
  font-weight: 400;
}

.audio-player {
  width: 100%;
  background: #f5f5f7;
  padding: 20px;
  border-radius: 12px;
}

.audio-player audio {
  width: 100%;
}

.preview-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.submit-button,
.reset-button {
  padding: 12px 32px;
  font-size: 17px;
  font-weight: 400;
  border: none;
  border-radius: 22px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
}

.submit-button {
  background: #0071e3;
  color: white;
}

.submit-button:hover:not(:disabled) {
  background: #0077ed;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 113, 227, 0.3);
}

.reset-button {
  background: transparent;
  color: #86868b;
  border: 1px solid #d2d2d7;
}

.reset-button:hover:not(:disabled) {
  background: #f5f5f7;
  border-color: #86868b;
}

.submit-button:disabled,
.reset-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  border-radius: 12px;
  z-index: 10;
}

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #d2d2d7;
  border-top: 3px solid #0071e3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-overlay p {
  color: #86868b;
  font-weight: 400;
  font-size: 17px;
}
